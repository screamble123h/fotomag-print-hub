# Copy to upload_gateway/.env on a Russian-hosted VPS; DO NOT COMMIT actual .env.
FOTOMAG_API_DOMAIN=files.example.ru
FOTOMAG_SITE_ORIGIN=https://screamble123h.github.io
FOTOMAG_AGENT_TOKEN=REPLACE_WITH_random_64_character_secret_generated_on_server
FOTOMAG_DATA_DIR=/data
# Keep disabled until HTTPS domain, privacy policy, anti-abuse and ClamAV are verified.
FOTOMAG_UPLOAD_MODE=disabled
FOTOMAG_CLAMD_HOST=clamav
FOTOMAG_CLAMD_PORT=3310
# 5 GiB/day global reservation, at least 3 GiB spare disk; no automatic deletion.
FOTOMAG_DAILY_BYTE_BUDGET=5368709120
FOTOMAG_MIN_FREE_BYTES=3221225472
